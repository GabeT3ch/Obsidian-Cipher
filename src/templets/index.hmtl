<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Obsidian Cipher</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #07070f;
      --surface:   #0f0f1a;
      --surface2:  #16162a;
      --border:    #2a2a45;
      --accent:    #8b5cf6;
      --accent-lo: #5b21b6;
      --cyan:      #22d3ee;
      --cyan-lo:   #0e7490;
      --text:      #e2e8f0;
      --text-dim:  #7c8db5;
      --green:     #10b981;
      --red:       #f87171;
      --radius:    12px;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 16px 60px;
    }

    header {
      width: 100%;
      max-width: 720px;
      text-align: center;
      padding: 52px 0 36px;
    }

    .gem {
      display: inline-block;
      font-size: 48px;
      filter: drop-shadow(0 0 18px #8b5cf688);
      margin-bottom: 10px;
      animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { filter: drop-shadow(0 0 14px #8b5cf688); }
      50%       { filter: drop-shadow(0 0 28px #8b5cf6cc); }
    }

    h1 {
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      background: linear-gradient(135deg, #a78bfa, #22d3ee);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .subtitle {
      margin-top: 8px;
      color: var(--text-dim);
      font-size: 0.9rem;
      letter-spacing: 0.04em;
    }

    #session-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 18px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      border: 1px solid transparent;
      transition: all 0.3s;
    }

    #session-badge.active   { background: #10b98122; border-color: #10b98155; color: var(--green); }
    #session-badge.inactive { background: #f8717122; border-color: #f8717155; color: var(--red); }

    .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }

    .tab-bar {
      display: flex;
      gap: 4px;
      background: var(--surface);
      padding: 4px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      margin-bottom: 24px;
      width: 100%;
      max-width: 720px;
    }

    .tab {
      flex: 1;
      padding: 10px 0;
      border: none;
      border-radius: 8px;
      background: transparent;
      color: var(--text-dim);
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.06em;
      transition: all 0.2s;
    }

    .tab.active            { background: var(--surface2); color: var(--text); box-shadow: inset 0 0 0 1px var(--border); }
    .tab.encrypt.active    { color: var(--accent); }
    .tab.decrypt.active    { color: var(--cyan); }

    .card {
      width: 100%;
      max-width: 720px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
      display: none;
    }

    .card.visible { display: block; }

    label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--text-dim);
      margin-bottom: 8px;
      text-transform: uppercase;
    }

    textarea, input[type="text"], input[type="password"] {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.92rem;
      font-family: inherit;
      padding: 12px 14px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      resize: vertical;
    }

    textarea:focus, input:focus              { border-color: var(--accent); box-shadow: 0 0 0 3px #8b5cf622; }
    .decrypt-card textarea:focus,
    .decrypt-card input:focus                { border-color: var(--cyan);   box-shadow: 0 0 0 3px #22d3ee22; }

    textarea  { min-height: 100px; }
    .field    { margin-bottom: 20px; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 28px;
      border: none;
      border-radius: 8px;
      font-size: 0.94rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      cursor: pointer;
      transition: all 0.18s;
      width: 100%;
    }

    .btn:disabled { opacity: 0.55; cursor: not-allowed; }

    .btn-encrypt {
      background: linear-gradient(135deg, var(--accent-lo), var(--accent));
      color: #fff;
      box-shadow: 0 4px 20px #8b5cf633;
    }

    .btn-encrypt:hover:not(:disabled) { box-shadow: 0 6px 28px #8b5cf655; transform: translateY(-1px); }

    .btn-decrypt {
      background: linear-gradient(135deg, var(--cyan-lo), var(--cyan));
      color: #07070f;
      box-shadow: 0 4px 20px #22d3ee33;
    }

    .btn-decrypt:hover:not(:disabled) { box-shadow: 0 6px 28px #22d3ee55; transform: translateY(-1px); }

    .spinner {
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: none;
    }

    .btn-decrypt .spinner { border-color: rgba(0,0,0,0.25); border-top-color: #07070f; }

    @keyframes spin { to { transform: rotate(360deg); } }

    .btn.loading .spinner   { display: block; }
    .btn.loading .btn-label { display: none; }

    .result-box {
      margin-top: 24px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px 18px;
      display: none;
      animation: fadeIn 0.25s ease;
    }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; } }

    .result-box.visible { display: block; }

    .result-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .result-label         { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
    .result-label.success { color: var(--green); }
    .result-label.error   { color: var(--red); }

    .copy-btn {
      background: var(--border);
      border: none;
      border-radius: 5px;
      color: var(--text-dim);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 10px;
      cursor: pointer;
      transition: all 0.15s;
      letter-spacing: 0.04em;
    }

    .copy-btn:hover  { background: var(--accent-lo); color: #fff; }
    .copy-btn.copied { background: #10b98133; color: var(--green); }

    .result-value            { font-family: 'Courier New', monospace; font-size: 0.85rem; color: var(--text); word-break: break-all; line-height: 1.6; white-space: pre-wrap; }
    .result-value.error-text { color: var(--red); font-family: inherit; }

    .api-note       { margin-top: 14px; font-size: 0.75rem; color: var(--text-dim); display: flex; align-items: center; gap: 6px; }
    .api-note span  { color: var(--accent); font-weight: 700; }

    footer { margin-top: 48px; color: var(--text-dim); font-size: 0.75rem; letter-spacing: 0.06em; text-align: center; }
    footer strong { color: var(--accent); }
  </style>
</head>
<body>

  <header>
    <div class="gem">💎</div>
    <h1>OBSIDIAN</h1>
    <p class="subtitle">16-Round Substitution-Permutation Network · 128-bit Block Cipher</p>
    <div id="session-badge" class="inactive">
      <div class="dot"></div>
      <span id="session-text">No session keys</span>
    </div>
  </header>

  <div class="tab-bar">
    <button class="tab encrypt active" onclick="switchTab('encrypt')">🔒 ENCRYPT</button>
    <button class="tab decrypt"        onclick="switchTab('decrypt')">🔓 DECRYPT</button>
  </div>

  <div class="card encrypt-card visible" id="encrypt-card">
    <div class="field">
      <label>Plaintext Message</label>
      <textarea id="enc-message" placeholder="Enter the message to encrypt…"></textarea>
    </div>
    <div class="field">
      <label>Secret Key</label>
      <input type="password" id="enc-key" placeholder="Enter your secret key…" />
    </div>
    <button class="btn btn-encrypt" id="enc-btn" onclick="doEncrypt()">
      <div class="spinner"></div>
      <span class="btn-label">⚡ ENCRYPT</span>
    </button>
    <div class="api-note">
      <span>1 API call</span> per encrypt — session keys saved automatically for zero-cost decryption.
    </div>
    <div class="result-box" id="enc-result">
      <div class="result-header">
        <span class="result-label success" id="enc-result-label">CIPHERTEXT (HEX)</span>
        <button class="copy-btn" id="enc-copy" onclick="copyResult('enc-value','enc-copy')">COPY</button>
      </div>
      <div class="result-value" id="enc-value"></div>
    </div>
  </div>

  <div class="card decrypt-card" id="decrypt-card">
    <div class="field">
      <label>Ciphertext (Hex)</label>
      <textarea id="dec-ciphertext" placeholder="Paste the hex ciphertext here…" style="font-family:'Courier New',monospace;font-size:0.85rem;"></textarea>
    </div>
    <div class="field">
      <label>Secret Key</label>
      <input type="password" id="dec-key" placeholder="Enter the same key used to encrypt…" />
    </div>
    <button class="btn btn-decrypt" id="dec-btn" onclick="doDecrypt()">
      <div class="spinner"></div>
      <span class="btn-label">🔍 DECRYPT</span>
    </button>
    <div class="result-box" id="dec-result">
      <div class="result-header">
        <span class="result-label success" id="dec-result-label">PLAINTEXT</span>
        <button class="copy-btn" id="dec-copy" onclick="copyResult('dec-value','dec-copy')">COPY</button>
      </div>
      <div class="result-value" id="dec-value"></div>
    </div>
  </div>

  <footer>
    Powered by <strong>Anthropic Claude</strong> · Session keys stored locally · Zero external data transmission
  </footer>

  <script>
    function switchTab(tab) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.card').forEach(c => c.classList.remove('visible'));
      document.querySelector(`.tab.${tab}`).classList.add('active');
      document.getElementById(`${tab}-card`).classList.add('visible');
    }

    async function refreshSessionBadge() {
      try {
        const res  = await fetch('/api/session-status');
        const data = await res.json();
        const badge = document.getElementById('session-badge');
        const text  = document.getElementById('session-text');
        if (data.has_session) {
          badge.className = 'active';
          text.textContent = 'Session keys active';
        } else {
          badge.className = 'inactive';
          text.textContent = 'No session keys — encrypt first';
        }
      } catch (_) {}
    }

    refreshSessionBadge();

    async function doEncrypt() {
      const message = document.getElementById('enc-message').value.trim();
      const key     = document.getElementById('enc-key').value.trim();
      const btn     = document.getElementById('enc-btn');
      const result  = document.getElementById('enc-result');
      const label   = document.getElementById('enc-result-label');
      const value   = document.getElementById('enc-value');
      const copy    = document.getElementById('enc-copy');

      btn.classList.add('loading');
      btn.disabled = true;
      result.classList.remove('visible');

      try {
        const res  = await fetch('/api/encrypt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, key }),
        });
        const data = await res.json();
        result.classList.add('visible');

        if (data.success) {
          label.textContent = 'CIPHERTEXT (HEX)';
          label.className   = 'result-label success';
          value.textContent = data.ciphertext;
          value.className   = 'result-value';
          copy.style.display = 'block';
          document.getElementById('dec-ciphertext').value = data.ciphertext;
          refreshSessionBadge();
        } else {
          label.textContent = 'ERROR';
          label.className   = 'result-label error';
          value.textContent = data.error;
          value.className   = 'result-value error-text';
          copy.style.display = 'none';
        }
      } catch (err) {
        result.classList.add('visible');
        label.textContent = 'ERROR';
        label.className   = 'result-label error';
        value.textContent = `Network error: ${err.message}`;
        value.className   = 'result-value error-text';
      } finally {
        btn.classList.remove('loading');
        btn.disabled = false;
      }
    }

    async function doDecrypt() {
      const ciphertext = document.getElementById('dec-ciphertext').value.trim();
      const key        = document.getElementById('dec-key').value.trim();
      const btn        = document.getElementById('dec-btn');
      const result     = document.getElementById('dec-result');
      const label      = document.getElementById('dec-result-label');
      const value      = document.getElementById('dec-value');
      const copy       = document.getElementById('dec-copy');

      btn.classList.add('loading');
      btn.disabled = true;
      result.classList.remove('visible');

      try {
        const res  = await fetch('/api/decrypt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ciphertext, key }),
        });
        const data = await res.json();
        result.classList.add('visible');

        if (data.success) {
          label.textContent = 'PLAINTEXT';
          label.className   = 'result-label success';
          value.textContent = data.plaintext;
          value.className   = 'result-value';
          copy.style.display = 'block';
        } else {
          label.textContent = 'ERROR';
          label.className   = 'result-label error';
          value.textContent = data.error;
          value.className   = 'result-value error-text';
          copy.style.display = 'none';
        }
      } catch (err) {
        result.classList.add('visible');
        label.textContent = 'ERROR';
        label.className   = 'result-label error';
        value.textContent = `Network error: ${err.message}`;
        value.className   = 'result-value error-text';
      } finally {
        btn.classList.remove('loading');
        btn.disabled = false;
      }
    }

    async function copyResult(valueId, btnId) {
      const text = document.getElementById(valueId).textContent;
      const btn  = document.getElementById(btnId);
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'COPIED ✓';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'COPY'; btn.classList.remove('copied'); }, 1800);
      } catch (_) {
        btn.textContent = 'FAILED';
        setTimeout(() => { btn.textContent = 'COPY'; }, 1500);
      }
    }

    document.getElementById('enc-key').addEventListener('keydown', e => { if (e.key === 'Enter') doEncrypt(); });
    document.getElementById('dec-key').addEventListener('keydown', e => { if (e.key === 'Enter') doDecrypt(); });
  </script>
</body>
</html>
